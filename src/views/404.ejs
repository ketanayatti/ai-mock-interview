<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Page Not Found | CommunicateAI Pro</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

  <main class="min-h-screen flex items-center justify-center" style="padding: 24px;">
    <div class="text-center fade-in" style="max-width: 480px;">

      <!-- 404 Number -->
      <h1 style="font-size: 120px; font-weight: 700; line-height: 1; letter-spacing: -0.04em; color: var(--text-primary); margin-bottom: 8px;">404</h1>

      <h2 class="mb-4" style="font-size: 24px;">Page Not Found</h2>

      <p class="mb-8" style="color: var(--text-secondary); max-width: 380px; margin-left: auto; margin-right: auto;">
        The page you're looking for doesn't exist or may have been moved.
      </p>

      <!-- Card -->
      <div class="card-static p-8 mb-8">
        <div style="width: 56px; height: 56px; border-radius: 50%; background: var(--bg-color); display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; color: var(--text-tertiary); font-size: 24px;">
          <i class="fas fa-robot"></i>
        </div>
        <p class="text-sm mb-6" style="color: var(--text-secondary);">Even our AI interviewer can't find this page!</p>
        <a href="/" class="btn btn-primary">
          <i class="fas fa-home mr-1"></i> Return to Home
        </a>
      </div>

      <!-- Links -->
      <div class="flex items-center justify-center gap-8">
        <a href="/" class="nav-link">Home</a>
        <a href="/welcome" class="nav-link">Get Started</a>
        <a href="/dashboard" class="nav-link">Dashboard</a>
      </div>

    </div>
  </main>

</body>
</html>
