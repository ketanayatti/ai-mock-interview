<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Session Created | CommunicateAI Pro</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

  <main class="min-h-screen flex items-center justify-center" style="padding: 24px;">
    <div class="fade-in" style="max-width: 420px; width: 100%;">

      <div class="card-static p-8 text-center">
        <!-- Success Icon -->
        <div style="width: 64px; height: 64px; border-radius: 50%; background: var(--success-subtle); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; color: var(--success-color); font-size: 24px;">
          <i class="fas fa-check"></i>
        </div>

        <h2 class="mb-2" style="font-size: 24px;">Session Created!</h2>
        <p class="text-sm mb-6" style="color: var(--text-secondary);">Welcome, <strong><%= name %></strong></p>

        <!-- Session ID Warning -->
        <div class="alert alert-warning mb-6" style="flex-direction: column; align-items: flex-start; gap: 8px;">
          <div class="flex items-center gap-2">
            <i class="fas fa-exclamation-circle"></i>
            <strong>Important: Save Your Session ID</strong>
          </div>
          <p style="font-size: 12px; color: inherit; opacity: 0.85;">Please save this ID to continue your session in the future.</p>
        </div>

        <!-- Session ID Display -->
        <div class="p-4 mb-6" style="background: var(--bg-color); border: 1px solid var(--border-color); border-radius: var(--radius-card);">
          <code class="font-mono font-bold text-xl select-all" style="color: var(--text-primary); letter-spacing: 0.05em;"><%= uniqueId %></code>
          <p class="text-xs mt-2" style="color: var(--text-tertiary);">Keep this ID in a secure place</p>
        </div>

        <!-- Continue Button -->
        <a href="/dashboard" class="btn btn-primary w-full" style="padding: 14px;">
          Continue to Dashboard <i class="fas fa-arrow-right ml-2"></i>
        </a>
      </div>

    </div>
  </main>

</body>
</html>
