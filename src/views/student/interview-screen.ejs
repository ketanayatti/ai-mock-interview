<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Interview | CommunicateAI Pro</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css">

  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

  <style>
    /* Specific styles for Interview Screen */
    .interview-layout {
      height: 100vh;
      display: flex;
      flex-direction: column;
      background: #000;
      /* Video focus often needs dark, but let's try keep it light/neutral or dark for contrast */
      background: var(--bg-color);
      /* Stick to light theme as requested */
    }

    .video-container {
      background: #000;
      border-radius: 16px;
      overflow: hidden;
      position: relative;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transform: scaleX(-1);
    }

    .controls-bar {
      padding: 16px;
      background: white;
      border-top: 1px solid var(--border-color);
      display: flex;
      justify-content: center;
      gap: 16px;
    }

    .transcript-panel {
      width: 350px;
      background: white;
      border-left: 1px solid var(--border-color);
      display: flex;
      flex-direction: column;
    }

    .transcript-content {
      flex: 1;
      overflow-y: auto;
      padding: 16px;
    }

    .question-overlay {
      position: absolute;
      bottom: 24px;
      left: 24px;
      right: 24px;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      padding: 16px 24px;
      border-radius: 12px;
      color: white;
      text-align: center;
      font-size: 18px;
      font-weight: 500;
      z-index: 10;
    }

    .mic-button {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      transition: all 0.2s;
    }

    .mic-button.active {
      background: var(--accent-color);
      color: white;
      box-shadow: 0 0 0 4px rgba(0, 113, 227, 0.2);
    }

    .mic-button.inactive {
      background: #F5F5F7;
      color: var(--text-primary);
    }

    .transcript-bubble {
      padding: 12px;
      border-radius: 12px;
      margin-bottom: 12px;
      font-size: 14px;
      line-height: 1.4;
    }

    .bubble-ai {
      background: #F5F5F7;
      color: var(--text-primary);
      border-top-left-radius: 2px;
    }

    .bubble-user {
      background: var(--accent-color);
      color: white;
      border-top-right-radius: 2px;
      margin-left: 24px;
    }

    .camera-placeholder {
      position: absolute;
      inset: 0;
      background: #1c1c1e;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #6e6e73;
    }
  </style>
</head>

<body>

  <div id="loadingOverlay" class="fixed inset-0 z-50 bg-white flex items-center justify-center flex-col">
    <div class="w-12 h-12 border-4 border-accent border-t-transparent rounded-full animate-spin mb-4"
      style="border-color: var(--accent-color); border-top-color: transparent;"></div>
    <h2 class="text-xl font-bold mb-2">Setting up Studio</h2>
    <p class="text-secondary">Preparing your <%= roundName %> interview...</p>
  </div>

  <div class="interview-layout">
    <!-- Header -->
    <header class="h-16 bg-white border-b border-gray-200 flex items-center justify-between px-6 z-20">
      <div class="flex items-center gap-4">
        <a href="/dashboard"
          class="flex items-center justify-center w-8 h-8 rounded-full bg-gray-100 hover:bg-gray-200 text-secondary transition">
          <i class="fas fa-chevron-left text-sm"></i>
        </a>
        <div>
          <h1 class="text-base font-bold">
            <%= space.companyName %> <span class="text-secondary font-normal">/ <%= space.jobPosition %></span>
          </h1>
          <div class="flex items-center gap-2 text-xs text-secondary">
            <span class="inline-block w-2 h-2 rounded-full bg-green-500"></span>
            Live Interview • <%= roundName %> Round
          </div>
        </div>
      </div>

      <div class="flex items-center gap-4">
        <div class="text-right">
          <p class="text-xs text-secondary font-medium mb-1" id="progressText">Question 1</p>
          <div class="w-32 h-1.5 bg-gray-100 rounded-full overflow-hidden">
            <div id="progressBar" class="h-full bg-accent transition-all duration-500"
              style="background-color: var(--accent-color); width: 0%;"></div>
          </div>
        </div>
      </div>
    </header>

    <!-- Workspace -->
    <div class="flex flex-1 overflow-hidden p-6 gap-6">
      <!-- Video Screen -->
      <div class="video-container relative group">
        <video id="webcam" autoplay playsinline muted></video>

        <div id="videoPlaceholder" class="camera-placeholder">
          <div class="text-center">
            <i class="fas fa-video-slash text-4xl mb-4 opacity-50"></i>
            <p>Camera Off</p>
          </div>
        </div>

        <!-- AI Visual (Picture-in-Picture style top right) -->
        <div
          class="absolute top-4 right-4 w-32 h-40 bg-white rounded-lg shadow-lg overflow-hidden border border-gray-200 z-10">
          <div class="h-full w-full bg-gray-50 flex flex-col items-center justify-center p-2 text-center">
            <img src="https://api.dicebear.com/7.x/bottts/svg?seed=<%= spaceId %>" class="w-16 h-16 mb-2">
            <p class="text-xs font-bold truncate w-full">AI Recruiter</p>
            <span id="aiStatus" class="text-[10px] text-secondary">Ready</span>
          </div>
        </div>

        <!-- Question Overlay -->
        <div class="question-overlay fade-in">
          <p id="questionContainer">Connecting...</p>
        </div>
      </div>

      <!-- Sidebar Transcript -->
      <div class="transcript-panel rounded-xl border border-gray-200 overflow-hidden shadow-sm hidden md:flex">
        <div class="p-4 border-b border-gray-200 bg-gray-50">
          <h3 class="text-sm font-semibold uppercase text-secondary">Transcript</h3>
        </div>
        <div id="transcriptContainer" class="transcript-content">
          <p class="text-center text-secondary text-sm mt-10">Interview starting...</p>
        </div>
        <div class="p-4 border-t border-gray-200 bg-gray-50">
          <textarea id="answer"
            class="w-full bg-white border border-gray-200 rounded-lg p-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 min-h-[80px] resize-none"
            placeholder="Your answer will appear here..." readonly></textarea>
        </div>
      </div>
    </div>

    <!-- Controls Bar -->
    <div class="controls-bar">
      <button id="cameraToggle"
        class="btn btn-secondary rounded-full w-12 h-12 flex items-center justify-center text-lg" title="Toggle Camera">
        <i class="fas fa-video"></i>
      </button>

      <button id="micButton" class="mic-button inactive shadow-sm" title="Start Recording">
        <i class="fas fa-microphone"></i>
      </button>

      <button id="nextButton" class="btn btn-primary rounded-full px-6 flex items-center gap-2" disabled>
        <span>Next</span>
        <i class="fas fa-arrow-right"></i>
      </button>
    </div>
  </div>

  <script>
    // Variables
    const spaceId = "<%= spaceId %>";
    const roundName = "<%= roundName %>";
    let currentQuestionIndex = 0;
    let totalQuestions = 0;
    let conversationHistory = [];
    let currentQuestionText = "";
    let answers = {};
    let mediaStream = null;
    let recognition = null;
    let isRecording = false;
    let finalTranscriptGlobal = "";

    // Init
    document.addEventListener("DOMContentLoaded", () => {
      initializeCamera();
      initializeInterview();

      document.getElementById("micButton").onclick = toggleSpeechRecognition;
      document.getElementById("nextButton").onclick = saveAnswerAndNext;
      document.getElementById("cameraToggle").onclick = toggleCamera;
    });

    async function initializeInterview() {
      try {
        const response = await fetch(`/generate-questions/${spaceId}/${roundName}`);
        const data = await response.json();

        if (data.error) throw new Error(data.error);

        currentQuestionText = data.question;
        currentQuestionIndex = data.questionNumber || 1;
        totalQuestions = data.totalQuestions || 10;

        document.getElementById("loadingOverlay").classList.add("hidden");
        updateProgress(currentQuestionIndex, totalQuestions);
        showQuestion(currentQuestionText);

      } catch (err) {
        console.error(err);
        alert("Failed to start interview. Please refresh.");
      }
    }

    async function initializeCamera() {
      try {
        mediaStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });
        const video = document.getElementById("webcam");
        video.srcObject = mediaStream;
        document.getElementById("videoPlaceholder").classList.add("hidden");
      } catch (err) {
        console.error("Camera access denied", err);
        document.getElementById("videoPlaceholder").classList.remove("hidden");
      }
    }

    // Interaction
    function showQuestion(text) {
      document.getElementById('questionContainer').innerText = text;
      document.getElementById('aiStatus').innerText = 'Speaking...';
      document.getElementById('aiStatus').className = 'text-[10px] text-accent font-bold';

      finalTranscriptGlobal = "";
      document.getElementById('answer').value = '';
      document.getElementById('nextButton').disabled = true;

      if (isRecording) stopUnknown();

      // TTS
      if ('speechSynthesis' in window) {
        speechSynthesis.cancel();
        const ut = new SpeechSynthesisUtterance(text);
        // Attempt to select a better voice
        const voices = speechSynthesis.getVoices();
        const preferredVoice = voices.find(v => v.name.includes('Google US English') || v.name.includes('Samantha'));
        if (preferredVoice) ut.voice = preferredVoice;

        ut.onend = () => {
          document.getElementById('aiStatus').innerText = 'Listening...';
          document.getElementById('aiStatus').className = 'text-[10px] text-success font-bold';
          setTimeout(startUnknown, 500);
        };
        speechSynthesis.speak(ut);
      } else {
        // Fallback if no TTS
        startUnknown();
      }
    }

    function toggleSpeechRecognition() {
      if (isRecording) stopUnknown();
      else startUnknown();
    }

    function startUnknown() {
      if (!recognition) setupSpeechRecognition();
      try {
        recognition.start();
        isRecording = true;
        updateMicUI(true);
      } catch (e) { console.warn("Mic already on"); }
    }

    function stopUnknown() {
      if (recognition) recognition.stop();
      isRecording = false;
      updateMicUI(false);
    }

    function updateMicUI(active) {
      const btn = document.getElementById("micButton");
      const sub = document.getElementById("answer");
      if (active) {
        btn.classList.add('active');
        btn.classList.remove('inactive');
        btn.innerHTML = '<i class="fas fa-stop"></i>';
        sub.placeholder = "Listening...";
      } else {
        btn.classList.remove('active');
        btn.classList.add('inactive');
        btn.innerHTML = '<i class="fas fa-microphone"></i>';
        sub.placeholder = "Click mic to speak...";
      }
    }

    function setupSpeechRecognition() {
      if ('webkitSpeechRecognition' in window) {
        recognition = new webkitSpeechRecognition();
        recognition.continuous = true;
        recognition.interimResults = true;

        recognition.onresult = (event) => {
          let interimTranscript = '';
          for (let i = event.resultIndex; i < event.results.length; ++i) {
            if (event.results[i].isFinal) {
              finalTranscriptGlobal += event.results[i][0].transcript + ' ';
            } else {
              interimTranscript += event.results[i][0].transcript;
            }
          }
          const displayText = finalTranscriptGlobal + interimTranscript;
          document.getElementById('answer').value = displayText;
          if (displayText.length > 3) document.getElementById("nextButton").disabled = false;
        };

        recognition.onend = () => {
          if (isRecording) try { recognition.start(); } catch (e) { }
          else updateMicUI(false);
        }
      }
    }

    async function saveAnswerAndNext() {
      const answerText = document.getElementById("answer").value.trim();
      if (!answerText) return;

      stopUnknown();
      isRecording = false;

      const btn = document.getElementById("nextButton");
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
      btn.disabled = true;

      // Add to transcript
      addToTranscript(currentQuestionText, answerText);
      answers[currentQuestionText] = answerText;
      conversationHistory.push({ question: currentQuestionText, answer: answerText });

      try {
        const nextQNum = currentQuestionIndex + 1;
        const response = await fetch(`/next-question/${spaceId}/${roundName}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ conversationHistory, currentQuestionNumber: nextQNum })
        });
        const data = await response.json();

        if (data.done) {
          finishInterview();
        } else {
          // Transition
          currentQuestionText = data.question;
          currentQuestionIndex = data.questionNumber;
          updateProgress(currentQuestionIndex, totalQuestions);
          showQuestion(currentQuestionText);
          btn.innerHTML = '<span>Next</span><i class="fas fa-arrow-right"></i>';
        }
      } catch (e) {
        console.error(e);
        btn.innerHTML = 'Retry';
        btn.disabled = false;
      }
    }

    async function finishInterview() {
      document.getElementById("questionContainer").innerText = "Interview Completed. Processing...";
      await fetch(`/finish-round/${spaceId}/${roundName}`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ answers })
      });
      window.location.href = `/space/${spaceId}`;
    }

    function updateProgress(curr, tot) {
      document.getElementById("progressText").innerText = `Question ${curr} of ${tot}`;
      const pct = (curr / tot) * 100;
      document.getElementById("progressBar").style.width = pct + '%';
    }

    function addToTranscript(q, a) {
      const container = document.getElementById("transcriptContainer");
      if (container.innerText.includes("Interview starting")) container.innerHTML = "";

      const html = `
         <div class="transcript-bubble bubble-ai">
            <p class="text-xs font-bold mb-1">AI</p>
            ${q}
         </div>
         <div class="transcript-bubble bubble-user">
            <p class="text-xs font-bold mb-1 opacity-80">You</p>
            ${a}
         </div>
       `;
      container.insertAdjacentHTML('beforeend', html);
      container.scrollTop = container.scrollHeight;
    }

    function toggleCamera() {
      const vid = document.getElementById("webcam");
      const btn = document.getElementById("cameraToggle");
      if (mediaStream) {
        const track = mediaStream.getVideoTracks()[0];
        track.enabled = !track.enabled;
        if (track.enabled) {
          document.getElementById("videoPlaceholder").classList.add("hidden");
          btn.innerHTML = '<i class="fas fa-video"></i>';
          btn.classList.remove('text-red-500');
        } else {
          document.getElementById("videoPlaceholder").classList.remove("hidden");
          btn.innerHTML = '<i class="fas fa-video-slash"></i>';
          btn.classList.add('text-red-500');
        }
      }
    }
  </script>
</body>

</html>