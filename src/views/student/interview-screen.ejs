<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Live Interview | Space</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Outfit', 'sans-serif'] },
          colors: {
            dark: '#0a0a0c',
            surface: 'rgba(20, 20, 24, 0.65)',
            accent: '#38bdf8', /* Light blue */
            secondary: '#94a3b8'
          }
        }
      }
    }
  </script>

  <style>
    body {
      background-color: #0a0a0c;
      color: #f8fafc;
      font-family: 'Outfit', sans-serif;
      margin: 0;
      height: 100vh;
      overflow: hidden;
      background-image: radial-gradient(circle at 15% 50%, rgba(56, 189, 248, 0.08), transparent 25%),
                        radial-gradient(circle at 85% 30%, rgba(139, 92, 246, 0.08), transparent 25%);
    }

    /* Glassmorphism Classes */
    .glass-panel {
      background: var(--surface, rgba(20, 20, 24, 0.4));
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
    }
    
    .glass-header {
      background: linear-gradient(180deg, rgba(10, 10, 12, 0.9) 0%, rgba(10, 10, 12, 0) 100%);
      backdrop-filter: blur(8px);
    }

    /* Video Frame */
    .video-wrapper {
      position: relative;
      border-radius: 24px;
      overflow: hidden;
      background: #000;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.05);
      transition: all 0.3s ease;
    }
    
    .video-wrapper.ai-speaking {
      box-shadow: 0 0 0 1px rgba(56, 189, 248, 0.5), 0 0 40px rgba(56, 189, 248, 0.2);
    }

    video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transform: scaleX(-1);
      filter: contrast(1.05) saturate(1.1);
    }

    /* Controls */
    .control-bar {
      position: absolute;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 16px;
      padding: 12px 24px;
      border-radius: 100px;
      z-index: 50;
    }

    .mic-btn {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.1);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      border: 1px solid rgba(255, 255, 255, 0.1);
      cursor: pointer;
    }

    .mic-btn:hover {
      background: rgba(255, 255, 255, 0.2);
      transform: scale(1.05);
    }

    .mic-btn.active {
      background: #ef4444; /* Red for recording */
      color: white;
      border-color: #ef4444;
      animation: pulse-red 2s infinite;
    }

    @keyframes pulse-red {
      0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
      70% { box-shadow: 0 0 0 20px rgba(239, 68, 68, 0); }
      100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
    }

    @keyframes pulse-ring {
      0% { transform: scale(0.8); opacity: 0.5; }
      100% { transform: scale(1.3); opacity: 0; }
    }

    .ai-avatar-ring {
      position: absolute;
      inset: -4px;
      border-radius: 50%;
      border: 2px solid #38bdf8;
      animation: pulse-ring 2s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
      display: none;
    }
    
    .ai-speaking .ai-avatar-ring {
      display: block;
    }

    /* Transcript bubbles */
    .bubble {
      padding: 14px 18px;
      border-radius: 16px;
      font-size: 15px;
      line-height: 1.5;
      margin-bottom: 16px;
      animation: slideUp 0.4s ease forwards;
      opacity: 0;
      transform: translateY(10px);
    }

    @keyframes slideUp {
      to { opacity: 1; transform: translateY(0); }
    }

    .bubble-ai {
      background: rgba(56, 189, 248, 0.1);
      border: 1px solid rgba(56, 189, 248, 0.2);
      border-top-left-radius: 4px;
      color: #bae6fd;
    }

    .bubble-user {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-top-right-radius: 4px;
      color: #f8fafc;
      margin-left: 20px;
    }

    /* Scrollbar */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }
    ::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.2); }

    /* Floating Question HUD */
    .question-hud {
      position: absolute;
      top: 40px;
      left: 50%;
      transform: translateX(-50%);
      width: 80%;
      max-width: 700px;
      text-align: center;
      pointer-events: none;
      z-index: 20;
    }

    .question-text {
      font-size: 24px;
      font-weight: 500;
      text-shadow: 0 2px 10px rgba(0,0,0,0.8);
      line-height: 1.4;
    }

  </style>
</head>

<body class="flex flex-col">

  <!-- Loader -->
  <div id="loadingOverlay" class="fixed inset-0 z-[100] bg-dark flex flex-col items-center justify-center transition-opacity duration-500">
    <div class="relative w-24 h-24 mb-6">
      <div class="absolute inset-0 border-t-2 border-accent rounded-full animate-[spin_1.5s_linear_infinite]"></div>
      <div class="absolute inset-2 border-r-2 border-purple-500 rounded-full animate-[spin_2s_linear_infinite_reverse]"></div>
      <i class="fas fa-brain absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-2xl text-accent"></i>
    </div>
    <h2 class="text-2xl font-bold tracking-wide text-white mb-2">Connecting to Recruiter</h2>
    <p class="text-secondary text-sm">Preparing <%= roundName %> environment...</p>
  </div>

  <!-- Header -->
  <header class="h-20 glass-header flex items-center justify-between px-8 z-50 absolute top-0 w-full">
    <div class="flex items-center gap-4">
      <a href="/dashboard" class="w-10 h-10 rounded-full bg-white/5 hover:bg-white/10 border border-white/10 flex items-center justify-center text-white transition-all backdrop-blur-md">
        <i class="fas fa-arrow-left text-sm"></i>
      </a>
      <div>
        <h1 class="text-lg font-bold text-white tracking-wide"><%= space.companyName %></h1>
        <div class="flex items-center gap-2 text-xs text-accent font-medium uppercase tracking-widest mt-0.5">
          <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span>
          Live Session • <%= roundName %>
        </div>
      </div>
    </div>
    <div class="flex flex-col items-end">
      <span class="text-xs text-secondary uppercase tracking-widest font-semibold mb-2" id="progressText">Question 1 / ?</span>
      <div class="w-48 h-1.5 bg-white/10 rounded-full overflow-hidden">
        <div id="progressBar" class="h-full bg-gradient-to-r from-accent to-purple-500 transition-all duration-700 ease-out" style="width: 0%;"></div>
      </div>
    </div>
  </header>

  <!-- Main Layout -->
  <main class="flex-1 flex w-full pt-20 pb-6 px-6 gap-6 h-full">
    
    <!-- Left: Video Area -->
    <div class="flex-1 h-full relative flex flex-col pt-4">
      <div id="videoContainer" class="video-wrapper flex-1 w-full h-full">
        
        <video id="webcam" autoplay playsinline muted></video>

        <!-- No Camera Fallback -->
        <div id="videoPlaceholder" class="absolute inset-0 bg-dark/80 backdrop-blur flex flex-col items-center justify-center hidden">
          <div class="w-20 h-20 rounded-full bg-white/5 flex items-center justify-center mb-4">
            <i class="fas fa-video-slash text-2xl text-secondary"></i>
          </div>
          <p class="text-secondary tracking-wide">Camera disabled</p>
        </div>

        <!-- Question HUD overlay on video -->
        <div class="question-hud">
          <div class="inline-block glass-panel px-8 py-4 rounded-2xl mx-auto shadow-2xl">
            <h3 class="text-accent text-xs uppercase tracking-widest font-bold mb-2 flex items-center justify-center gap-2">
              <i class="fas fa-comment-dots"></i> Current Question
            </h3>
            <p id="questionContainer" class="question-text text-white">Establishing connection...</p>
          </div>
        </div>

        <!-- Floating AI Identifier -->
        <div class="absolute top-6 right-6 glass-panel p-2 pr-4 pl-3 rounded-full flex items-center gap-3 border border-white/10">
          <div class="relative w-8 h-8 rounded-full bg-gradient-to-br from-indigo-500 to-accent flex items-center justify-center">
            <div class="ai-avatar-ring"></div>
            <img src="https://api.dicebear.com/7.x/bottts/svg?seed=<%= spaceId %>" class="w-6 h-6 z-10">
          </div>
          <div>
            <p class="text-xs font-bold text-white leading-none mb-1">AI Recruiter</p>
            <p id="aiLabel" class="text-[10px] text-accent uppercase tracking-widest leading-none font-semibold">Ready</p>
          </div>
        </div>

        <!-- Immersive Control Bar -->
        <div class="control-bar glass-panel shadow-2xl">
          <button id="cameraToggle" class="w-12 h-12 rounded-full hover:bg-white/10 flex items-center justify-center text-white transition" title="Toggle Video">
            <i class="fas fa-video"></i>
          </button>
          
          <button id="micButton" class="mic-btn shadow-lg" title="Hold/Tap to Speak">
            <i class="fas fa-microphone"></i>
          </button>
          
          <button id="nextButton" class="w-12 h-12 rounded-full hover:bg-white/10 flex items-center justify-center text-white transition disabled:opacity-30 disabled:hover:bg-transparent" disabled title="Next Question">
            <i class="fas fa-chevron-right"></i>
          </button>
        </div>

      </div>
    </div>

    <!-- Right: Transcript Panel -->
    <div class="w-[400px] h-full flex flex-col pt-4 hidden lg:flex">
      <div class="glass-panel flex-1 flex flex-col rounded-3xl overflow-hidden h-full">
        <!-- Panel Header -->
        <div class="h-14 border-b border-white/5 flex items-center px-6 bg-white/5">
          <i class="fas fa-align-left text-secondary mr-3"></i>
          <h3 class="text-sm tracking-widest uppercase font-semibold text-secondary">Live Transcript</h3>
        </div>

        <!-- Chat History -->
        <div id="transcriptContainer" class="flex-1 overflow-y-auto p-6 scroll-smooth">
          <div class="flex flex-col items-center justify-center h-full text-center opacity-50">
            <i class="fas fa-wave-square text-3xl text-secondary mb-4"></i>
            <p class="text-sm">Conversation history<br>will appear here</p>
          </div>
        </div>

        <!-- Live Subtitle Area -->
        <div class="p-4 border-t border-white/5 bg-black/20">
          <div class="relative">
             <textarea id="answer" class="w-full bg-white/5 border border-white/10 rounded-xl p-4 text-sm text-white placeholder-secondary focus:outline-none focus:border-accent resize-none transition-colors" rows="3" placeholder="Click the microphone to start answering..." readonly></textarea>
             <!-- Mini visualizer effect could go here -->
          </div>
        </div>
      </div>
    </div>

  </main>

  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script>
    // Configuration Variables
    const spaceId = "<%= spaceId %>";
    const roundName = "<%= roundName %>";
    let currentQuestionIndex = 0;
    let totalQuestions = 0;
    let conversationHistory = [];
    let currentQuestionText = "";
    let answers = {};
    let mediaStream = null;
    let recognition = null;
    let isRecording = false;
    let finalTranscriptGlobal = "";

    // Initialization
    document.addEventListener("DOMContentLoaded", () => {
      initializeCamera();
      initializeInterview();

      document.getElementById("micButton").onclick = toggleSpeechRecognition;
      document.getElementById("nextButton").onclick = saveAnswerAndNext;
      document.getElementById("cameraToggle").onclick = toggleCamera;
    });

    // 1. Fetch First Question
    async function initializeInterview() {
      try {
        const response = await fetch(`/generate-questions/${spaceId}/${roundName}`);
        const data = await response.json();

        if (data.error) throw new Error(data.error);

        currentQuestionText = data.question;
        currentQuestionIndex = data.questionNumber || 1;
        totalQuestions = data.totalQuestions || 10;

        // Fade out loader smoothly
        const overlay = document.getElementById("loadingOverlay");
        overlay.classList.add("opacity-0");
        setTimeout(() => overlay.classList.add("hidden"), 500);

        updateProgress(currentQuestionIndex, totalQuestions);
        showQuestion(currentQuestionText);

      } catch (err) {
        console.error(err);
        alert("Failed to connect to AI server. Please refresh the page.");
      }
    }

    // 2. Camera Setup
    async function initializeCamera() {
      try {
        mediaStream = await navigator.mediaDevices.getUserMedia({ video: { width: 1280, height: 720 }, audio: true });
        const video = document.getElementById("webcam");
        video.srcObject = mediaStream;
        document.getElementById("videoPlaceholder").classList.add("hidden");
      } catch (err) {
        console.error("Camera access denied", err);
        document.getElementById("videoPlaceholder").classList.remove("hidden");
      }
    }

    // 3. UI Updates & TTS
    function showQuestion(text) {
      document.getElementById('questionContainer').innerText = `"${text}"`;
      
      const aiLabel = document.getElementById('aiLabel');
      const videoCont = document.getElementById('videoContainer');
      
      aiLabel.innerText = 'Speaking';
      aiLabel.className = 'text-[10px] text-accent uppercase tracking-widest font-semibold';
      videoCont.classList.add('ai-speaking');

      finalTranscriptGlobal = "";
      document.getElementById('answer').value = '';
      document.getElementById('nextButton').disabled = true;

      if (isRecording) stopRecording();

      // Trigger standard Speech Synthesis
      if ('speechSynthesis' in window) {
        speechSynthesis.cancel();
        const utterance = new SpeechSynthesisUtterance(text);
        
        // Pick a premium sounding voice if available
        const voices = speechSynthesis.getVoices();
        const preferred = voices.find(v => v.name.includes('Google US English') || v.name.includes('Samantha') || v.name.includes('Daniel'));
        if (preferred) utterance.voice = preferred;
        
        utterance.rate = 1.05;

        utterance.onend = () => {
          aiLabel.innerText = 'Listening';
          aiLabel.className = 'text-[10px] text-emerald-400 uppercase tracking-widest font-semibold';
          videoCont.classList.remove('ai-speaking');
          // Auto start listening after a brief pause
          setTimeout(startRecording, 600);
        };
        
        speechSynthesis.speak(utterance);
      } else {
        videoCont.classList.remove('ai-speaking');
        startRecording();
      }
    }

    // 4. Speech Recognition
    function toggleSpeechRecognition() {
      if (isRecording) stopRecording();
      else startRecording();
    }

    function startRecording() {
      if (!recognition) setupSpeechRecognition();
      try {
        recognition.start();
        isRecording = true;
        updateButtonsUI(true);
      } catch (e) { console.warn("Mic already active"); }
    }

    function stopRecording() {
      if (recognition) recognition.stop();
      isRecording = false;
      updateButtonsUI(false);
    }

    function updateButtonsUI(active) {
      const btn = document.getElementById("micButton");
      const textarea = document.getElementById("answer");
      
      if (active) {
        btn.classList.add('active');
        btn.innerHTML = '<i class="fas fa-stop"></i>';
        textarea.placeholder = "Listening... Speak clearly into microphone.";
      } else {
        btn.classList.remove('active');
        btn.innerHTML = '<i class="fas fa-microphone"></i>';
        if(textarea.value.length === 0) {
           textarea.placeholder = "Click the microphone to start answering...";
        }
      }
    }

    function setupSpeechRecognition() {
      if ('webkitSpeechRecognition' in window) {
        recognition = new webkitSpeechRecognition();
        recognition.continuous = true;
        recognition.interimResults = true;

        recognition.onresult = (event) => {
          let interimTranscript = '';
          for (let i = event.resultIndex; i < event.results.length; ++i) {
            if (event.results[i].isFinal) {
              finalTranscriptGlobal += event.results[i][0].transcript + ' ';
            } else {
              interimTranscript += event.results[i][0].transcript;
            }
          }
          const displayText = finalTranscriptGlobal + interimTranscript;
          document.getElementById('answer').value = displayText;
          
          if (displayText.trim().length > 10) {
            document.getElementById("nextButton").disabled = false;
          }
        };

        recognition.onend = () => {
          if (isRecording) {
            try { recognition.start(); } catch (e) { } // Keep alive
          } else {
            updateButtonsUI(false);
          }
        }
      }
    }

    // 5. Submit Answer
    async function saveAnswerAndNext() {
      const answerText = document.getElementById("answer").value.trim();
      if (!answerText) return;

      stopRecording();
      
      const btn = document.getElementById("nextButton");
      btn.innerHTML = '<i class="fas fa-spinner fa-spin text-accent"></i>';
      btn.disabled = true;

      // Update Transcript UI
      addToTranscriptUI(currentQuestionText, answerText);
      
      answers[currentQuestionText] = answerText;
      conversationHistory.push({ question: currentQuestionText, answer: answerText });

      try {
        const nextQNum = currentQuestionIndex + 1;
        const response = await fetch(`/next-question/${spaceId}/${roundName}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ conversationHistory, currentQuestionNumber: nextQNum })
        });
        const data = await response.json();

        if (data.done) {
          finishInterview();
        } else {
          currentQuestionText = data.question;
          currentQuestionIndex = data.questionNumber;
          updateProgress(currentQuestionIndex, totalQuestions);
          showQuestion(currentQuestionText);
          btn.innerHTML = '<i class="fas fa-chevron-right"></i>';
        }
      } catch (e) {
        console.error(e);
        btn.innerHTML = '<i class="fas fa-redo"></i>';
        btn.disabled = false;
      }
    }

    async function finishInterview() {
      document.getElementById("questionContainer").innerHTML = "Interview Complete.<br><span class='text-sm text-accent'>Running Multi-AI Evaluation...</span>";
      
      const loadingHTML = `
        <div class="fixed inset-0 z-50 bg-dark/90 backdrop-blur-md flex flex-col items-center justify-center fade-in">
          <div class="text-accent text-5xl mb-6 animate-bounce"><i class="fas fa-file-signature"></i></div>
          <h2 class="text-2xl font-bold text-white mb-2">Analyzing Performance</h2>
          <p class="text-secondary text-center max-w-sm">Generating comprehensive report...</p>
        </div>
      `;
      document.body.insertAdjacentHTML('beforeend', loadingHTML);

      await fetch(`/finish-round/${spaceId}/${roundName}`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ answers })
      });
      
      window.location.href = `/space/${spaceId}`;
    }

    // Utils
    function updateProgress(curr, tot) {
      document.getElementById("progressText").innerText = `Question ${curr} of ${tot}`;
      const pct = (curr / tot) * 100;
      document.getElementById("progressBar").style.width = pct + '%';
    }

    function addToTranscriptUI(q, a) {
      const container = document.getElementById("transcriptContainer");
      
      // Clear empty state
      if(container.innerHTML.includes("fa-wave-square")) {
         container.innerHTML = "";
      }

      const html = `
         <div class="bubble bubble-ai">
            <p class="text-[10px] uppercase tracking-widest text-accent mb-1 font-bold"><i class="fas fa-robot mr-1"></i> AI Recruiter</p>
            ${q}
         </div>
         <div class="bubble bubble-user">
            <p class="text-[10px] uppercase tracking-widest text-secondary mb-1 font-bold"><i class="fas fa-user mr-1"></i> You</p>
            ${a}
         </div>
       `;
      container.insertAdjacentHTML('beforeend', html);
      container.scrollTop = container.scrollHeight;
    }

    function toggleCamera() {
      const btn = document.getElementById("cameraToggle");
      if (mediaStream) {
        const track = mediaStream.getVideoTracks()[0];
        track.enabled = !track.enabled;
        if (track.enabled) {
          document.getElementById("videoPlaceholder").classList.add("hidden");
          btn.innerHTML = '<i class="fas fa-video"></i>';
          btn.classList.remove('bg-red-500/20', 'text-red-400');
        } else {
          document.getElementById("videoPlaceholder").classList.remove("hidden");
          btn.innerHTML = '<i class="fas fa-video-slash"></i>';
          btn.classList.add('bg-red-500/20', 'text-red-400');
        }
      }
    }
  </script>
</body>
</html>