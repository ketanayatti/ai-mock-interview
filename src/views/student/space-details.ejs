<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= space.companyName %> · <%= space.jobPosition %> | CommunicateAI Pro
  </title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css">

  <style>
    /* Summary section transitions */
    .summary-section {
      display: none;
      animation: tabFadeIn 300ms ease;
    }

    .summary-section.active {
      display: block;
    }

    /* Modal scrolling */
    .modal-body-scroll {
      max-height: 60vh;
      overflow-y: auto;
    }

    body.no-scroll {
      overflow: hidden;
    }

    /* ===== Premium Modal Styles (Interview Summary) ===== */
    #interviewSummaryModal {
      background: rgba(0, 0, 0, 0.85);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }
    #interviewSummaryModal .modal-window {
      background: linear-gradient(145deg, #111113, #18181b);
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 30px 60px rgba(0,0,0,0.8), inset 0 1px 0 rgba(255, 255, 255, 0.1);
      color: #F5F5F7;
      border-radius: 20px;
      overflow: hidden;
      max-width: 900px;
    }
    #interviewSummaryModal .modal-close {
      background: rgba(255, 255, 255, 0.08) !important;
      color: #fff;
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
    }
    #interviewSummaryModal .modal-close:hover {
      background: rgba(255, 255, 255, 0.2) !important;
      transform: rotate(90deg);
    }
    #interviewSummaryModal h3 {
      color: #fff;
      font-weight: 700;
      letter-spacing: -0.02em;
      font-size: 22px;
    }
    
    /* Modal Tabs Overlay */
    #interviewSummaryModal .tabs {
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      padding: 0 8px;
    }
    #interviewSummaryModal .tab {
      color: rgba(255,255,255,0.4);
      font-weight: 500;
      transition: color 0.2s;
    }
    #interviewSummaryModal .tab:hover {
      color: rgba(255,255,255,0.8);
    }
    #interviewSummaryModal .tab.active {
      color: #0071E3;
      border-bottom: 2px solid #0071E3;
    }
    
    /* Summary Content text styling for dark mode */
    #interviewSummaryModal #summaryContent {
      color: #A1A1A6 !important;
      font-size: 15px;
      line-height: 1.7;
    }
    #interviewSummaryModal #summaryContent h1, 
    #interviewSummaryModal #summaryContent h2, 
    #interviewSummaryModal #summaryContent h3 {
      color: #FFF;
      margin-top: 24px;
      margin-bottom: 12px;
      font-weight: 600;
    }
    #interviewSummaryModal #summaryContent strong {
      color: #E5E5EA;
    }
    
    /* Glass Cards inside modal */
    #interviewSummaryModal .glass-card {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 16px;
      padding: 20px;
      transition: transform 0.2s;
    }
    #interviewSummaryModal .glass-card:hover {
      background: rgba(255, 255, 255, 0.05);
    }
    #interviewSummaryModal .glass-card h4 {
      color: #fff;
      margin-bottom: 16px;
    }
    #interviewSummaryModal ul#keyStrengths li span,
    #interviewSummaryModal ul#areasToImprove li span {
      color: #D2D2D7;
    }
    
    /* Q&A section modern cards */
    .qa-card {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255,255,255,0.05);
      border-radius: 16px;
      padding: 24px;
      transition: transform 0.2s, background 0.2s;
    }
    .qa-card:hover {
      background: rgba(255, 255, 255, 0.04);
      transform: translateY(-2px);
    }
    .qa-badge {
      display: inline-block;
      background: rgba(0, 113, 227, 0.15);
      color: #5AC8FA;
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 14px;
      border: 1px solid rgba(0, 113, 227, 0.3);
    }
    .qa-question {
      color: #FFF;
      font-size: 16px;
      font-weight: 600;
      margin-bottom: 16px;
      line-height: 1.6;
    }
    .qa-answer-box {
      background: rgba(0, 0, 0, 0.4);
      border-left: 3px solid #0071E3;
      padding: 16px 20px;
      border-radius: 0 12px 12px 0;
      color: #D2D2D7;
      font-size: 14.5px;
      line-height: 1.7;
      box-shadow: inset 0 2px 4px rgba(0,0,0,0.2);
    }
  </style>
</head>

<body>
  <% const completedRounds=space.interviewRounds.filter(r=> r.status === 'completed').length;
    const totalRounds = space.interviewRounds.length;
    const progressPercentage = totalRounds > 0 ? (completedRounds / totalRounds) * 100 : 0;
    %>

    <!-- ─── Navigation ─── -->
    <nav class="navbar" id="navbar">
      <div class="container nav-container">
        <a href="/dashboard" class="nav-logo">
          <div class="nav-logo-icon"><i class="fas fa-robot"></i></div>
          CommunicateAI
        </a>
        <div class="flex items-center gap-4">
          <a href="/dashboard" class="nav-link"><i class="fas fa-columns mr-1"></i> Dashboard</a>
          <a href="/profile" class="nav-link"><i class="fas fa-user mr-1"></i> Profile</a>
          <a href="/end-session" class="nav-link" style="color: var(--danger-color);"><i
              class="fas fa-sign-out-alt mr-1"></i>
            Sign Out</a>
        </div>
      </div>
    </nav>

    <!-- ─── Main Content ─── -->
    <main class="container" style="padding-top: 96px; padding-bottom: 64px; max-width: 1100px;">

      <!-- Breadcrumb -->
      <div class="mb-6 flex items-center gap-2 text-sm" style="color: var(--text-tertiary);">
        <a href="/dashboard" style="color: var(--text-secondary);" class="cursor-pointer">Dashboard</a>
        <i class="fas fa-chevron-right" style="font-size: 10px;"></i>
        <span style="color: var(--text-primary);">Interview Space</span>
      </div>

      <!-- ─── Space Header Card ─── -->
      <div class="space-header mb-8">
        <div class="space-header-banner"></div>
        <div class="space-header-content">
          <div class="flex items-start gap-6" style="flex-wrap: wrap;">
            <!-- Icon -->
            <div class="space-header-icon">
              <i class="fas fa-building"></i>
            </div>

            <!-- Info -->
            <div class="flex-1" style="min-width: 200px;">
              <h2 class="mb-1">
                <%= space.companyName %>
              </h2>
              <p class="text-lg" style="color: var(--text-secondary);">
                <%= space.jobPosition %>
              </p>
            </div>

            <!-- Progress Pill -->
            <div class="card-static p-4" style="min-width: 220px;">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-semibold uppercase"
                  style="color: var(--text-tertiary); letter-spacing: 0.05em;">Interview
                  Progress</span>
                <span class="text-sm font-bold">
                  <%= completedRounds %>/<%= totalRounds %>
                </span>
              </div>
              <div class="progress-bar-container">
                <div class="progress-bar-fill" style="<%= `width: ${progressPercentage}%;` %>"></div>
              </div>
            </div>
          </div>
          <!-- Resume Summary Preview -->
          <% if (space.purifiedSummary && space.purifiedSummary.length > 0) { %>
            <div class="mt-6 p-4 flex items-center justify-between"
              style="background:var(--bg-color);border-radius:var(--radius-sm);border:1px solid var(--border-color);">
              <div class="flex items-center gap-3">
                <div style="width:36px;height:36px;background:var(--accent-subtle);border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;color:var(--accent-color);font-size:14px;flex-shrink:0;">
                  <i class="fas fa-file-user"></i>
                </div>
                <div>
                  <p class="text-sm font-semibold" style="color:var(--text-primary);">Resume Intelligence Summary</p>
                  <p class="text-xs" style="color:var(--text-tertiary);margin-top:2px;">AI-distilled profile for interview context</p>
                </div>
              </div>
              <div class="flex items-center gap-2">
                <button id="viewFullSummaryBtn" class="btn btn-secondary btn-sm">
                  <i class="fas fa-eye" style="font-size:11px;"></i> View Summary
                </button>
                <% if (space.resumePath) { %>
                  <a href="/space/resume/download/<%= space._id %>" class="btn btn-outline btn-sm">
                    <i class="fas fa-download" style="font-size:11px;"></i> Resume
                  </a>
                <% } %>
              </div>
            </div>
          <% } else if (space.resumePath) { %>

              <div class="mt-6 p-4 flex items-center justify-between"
                style="background: var(--bg-color); border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                <div class="flex items-center gap-3">
                  <i class="fas fa-file-alt" style="color: var(--text-tertiary);"></i>
                  <p class="text-sm" style="color: var(--text-secondary);">Resume uploaded</p>
                </div>
                <a href="/space/resume/download/<%= space._id %>" class="btn btn-outline btn-sm">
                  <i class="fas fa-download"></i> Download
                </a>
              </div>
              <% } %>
        </div>
      </div>

      <!-- ─── Tabs ─── -->
      <div class="tabs">
        <button class="tab active" data-tab="rounds">Interview Rounds</button>
        <button class="tab" data-tab="details">Job Details</button>
        <button class="tab" data-tab="performance">Performance</button>
      </div>

      <!-- ─── Tab: Interview Rounds ─── -->
      <div id="roundsTab" class="tab-content active">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <% space.interviewRounds.forEach((round, index)=> { %>
            <div class="round-card">
              <div class="flex justify-between items-start mb-4">
                <div class="flex items-center gap-3">
                  <div class="round-icon">
                    <% if (round.name.toLowerCase().includes('hr')) { %>
                      <i class="fas fa-user-tie"></i>
                      <% } else if (round.name.toLowerCase().includes('tech')) { %>
                        <i class="fas fa-code"></i>
                        <% } else if (round.name.toLowerCase().includes('system')) { %>
                          <i class="fas fa-sitemap"></i>
                          <% } else if (round.name.toLowerCase().includes('behavior')) { %>
                            <i class="fas fa-brain"></i>
                            <% } else if (round.name.toLowerCase().includes('culture')) { %>
                              <i class="fas fa-users"></i>
                              <% } else if (round.name.toLowerCase().includes('case')) { %>
                                <i class="fas fa-clipboard-list"></i>
                                <% } else if (round.name.toLowerCase().includes('final')) { %>
                                  <i class="fas fa-flag-checkered"></i>
                                  <% } else { %>
                                    <i class="fas fa-comments"></i>
                                    <% } %>
                  </div>
                  <h4>
                    <%= round.name %> Round
                  </h4>
                </div>
                <% if (round.status==='completed' ) { %>
                  <span class="badge badge-success"><i class="fas fa-check-circle mr-1"></i> Completed</span>
                  <% } else if (round.status==='in_progress' ) { %>
                    <span class="badge badge-warning"><i class="fas fa-spinner mr-1"></i> In Progress</span>
                    <% } else { %>
                      <span class="badge badge-neutral"><i class="fas fa-clock mr-1"></i> Not Started</span>
                      <% } %>
              </div>

              <p class="text-sm mb-6" style="color: var(--text-secondary);">
                <% if (round.status==='completed' ) { %>
                  This round has been completed. View the summary of your performance.
                  <% } else if (round.status==='in_progress' ) { %>
                    This round is currently in progress. Continue where you left off.
                    <% } else { %>
                      Prepare for <%= round.name.toLowerCase() %> interview questions with AI-powered practice.
                        <% } %>
              </p>

              <% const isNotStarted=round.status==='not completed' || round.status==='pending' ||
                round.status==='not_started' || round.status==='not started' ; %>
                <% if (isNotStarted) { %>
                  <a href="/space/<%= space._id %>/round/<%= round.name %>/start" class="btn btn-primary w-full">
                    <i class="fas fa-play mr-1"></i> Start Interview
                  </a>
                  <% } else if (round.status==='in_progress' ) { %>
                    <a href="/space/<%= space._id %>/round/<%= round.name %>/continue" class="btn btn-accent w-full">
                      <i class="fas fa-redo mr-1"></i> Continue
                    </a>
                    <% } else { %>
                      <button class="btn btn-secondary w-full view-summary-btn" data-round-id="<%= round._id %>"
                        data-round-name="<%= round.name %>">
                        <i class="fas fa-chart-bar mr-1"></i> View Summary
                      </button>
                      <% } %>
            </div>
            <% }) %>
        </div>
      </div>

      <!-- ─── Tab: Job Details ─── -->
      <div id="detailsTab" class="tab-content">
        <!-- Job Description -->
        <div class="card-static p-6 mb-6">
          <div class="flex items-center gap-3 mb-4">
            <div class="round-icon"><i class="fas fa-briefcase"></i></div>
            <h3>Job Description</h3>
          </div>
          <div class="text-sm leading-relaxed" style="color: var(--text-secondary);">
            <% if (space.jobDescription && space.jobDescription.length> 0) { %>
              <%- space.jobDescription %>
                <% } else { %>
                  <div class="text-center py-8">
                    <i class="fas fa-file-alt text-3xl mb-3" style="color: var(--text-quaternary);"></i>
                    <p style="color: var(--text-tertiary);">No job description available</p>
                  </div>
                  <% } %>
          </div>
        </div>

        <!-- Key Requirements -->
        <div class="card-static p-6">
          <div class="flex items-center gap-3 mb-4">
            <div class="round-icon"><i class="fas fa-list-check"></i></div>
            <h3>Key Skills &amp; Requirements</h3>
          </div>
          <% let requirements=[]; const jobDescText=space.jobDescription || '' ;
            /* Regex to find list items - using safe new Regexp or single line to avoid parser issues */
            const listMatches=jobDescText.match(/<li[^>]*>(.*?)<\/li>/gi);
              if (listMatches) {
              listMatches.forEach(item => {
              const cleaned = item.replace(/<[^>]+>/g, '').trim();
                if (cleaned.length > 5) requirements.push(cleaned);
                });
                }
                if (requirements.length === 0) {
                const lines = jobDescText.split(/\r?\n/);
                lines.forEach(line => {
                const match = line.match(/^\s*(?:\*|-|\d+\.)\s*(.+)/);
                if (match && match[1].trim().length > 5) requirements.push(match[1].trim());
                });
                }

                if (requirements.length === 0) {
                requirements = [
                "3+ years of relevant experience",
                "Bachelor's degree in related field",
                "Strong communication skills",
                "Proficiency in required technologies",
                "Problem-solving abilities",
                "Teamwork and collaboration",
                "Attention to detail",
                "Time management skills"
                ];
                }
                %>
                <div id="keyRequirements" class="grid grid-cols-1 md:grid-cols-2 gap-3">
                  <% requirements.slice(0, 8).forEach(req=> { %>
                    <div class="flex items-start gap-2 p-3"
                      style="background: var(--bg-color); border-radius: var(--radius-xs); border: 1px solid var(--border-color);">
                      <i class="fas fa-check-circle"
                        style="color: var(--accent-color); margin-top: 2px; flex-shrink: 0;"></i>
                      <span class="text-sm" style="color: var(--text-secondary);">
                        <%= req %>
                      </span>
                    </div>
                    <% }) %>
                </div>
        </div>
      </div>

      <!-- ─── Tab: Performance ─── -->
      <div id="performanceTab" class="tab-content">
        <!-- Stats -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
          <div class="stat-card">
            <p class="stat-label">Completion Rate</p>
            <p class="stat-value">
              <%= Math.round(progressPercentage) %>%
            </p>
            <div class="progress-bar-container mt-3">
              <div class="progress-bar-fill" style="<%= `width: ${progressPercentage}%;` %>"></div>
            </div>
          </div>
          <div class="stat-card">
            <p class="stat-label">Total Questions</p>
            <p class="stat-value">
              <%= completedRounds * 15 %>
            </p>
            <p class="stat-sub">~15 questions per round</p>
          </div>
          <div class="stat-card">
            <p class="stat-label">Practice Time</p>
            <p class="stat-value">
              <%= completedRounds * 30 %> min
            </p>
            <p class="stat-sub">~30 minutes per round</p>
          </div>
        </div>

        <!-- Interview Timeline -->
        <% if (completedRounds> 0) { %>
          <div class="card-static p-6">
            <h4 class="mb-6">Interview Timeline</h4>
            <% const completedRoundsArray=space.interviewRounds .filter(r=> r.status === 'completed')
              .map((r, i) => {
              const mockDate = new Date();
              mockDate.setDate(mockDate.getDate() - i);
              const obj = r.toObject ? r.toObject() : {...r};
              return { ...obj, date: mockDate };
              });
              %>
              <div class="flex flex-col gap-4">
                <% completedRoundsArray.forEach((round, index)=> { %>
                  <div class="p-4 flex items-start gap-4"
                    style="background: var(--bg-color); border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                    <div
                      style="width: 32px; height: 32px; border-radius: 50%; background: var(--success-subtle); color: var(--success-color); display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 12px;">
                      <i class="fas fa-check"></i>
                    </div>
                    <div class="flex-1">
                      <div class="flex items-center justify-between mb-1">
                        <h4 style="font-size: 15px;">
                          <%= round.name %> Round
                        </h4>
                        <span class="text-xs" style="color: var(--text-tertiary);">
                          <%= round.date.toLocaleDateString('en-US', { month: 'short' , day: 'numeric' }) %>
                        </span>
                      </div>
                      <p class="text-sm mb-3" style="color: var(--text-secondary);">
                        <% if (round.summary && round.summary.length> 50) { %>
                          <%= round.summary.substring(0, 100) %>...
                            <% } else { %>
                              Interview completed successfully.
                              <% } %>
                      </p>
                      <button class="btn btn-secondary btn-sm view-summary-btn" data-round-id="<%= round._id %>"
                        data-round-name="<%= round.name %>">
                        View Details
                      </button>
                    </div>
                  </div>
                  <% }) %>
              </div>
          </div>
          <% } else { %>
            <div class="card-static p-8 text-center">
              <i class="fas fa-chart-bar text-3xl mb-3" style="color: var(--text-quaternary);"></i>
              <p style="color: var(--text-tertiary);">Complete interview rounds to see your performance data</p>
            </div>
            <% } %>
      </div>
    </main>

    <!-- ═══════════════════════════════════════
                         Resume Summary Modal — Premium Dark
         ═══════════════════════════════════════ -->
    <div id="resumeSummaryModal" class="modal-backdrop">
      <div class="modal-window" style="background:linear-gradient(145deg,#111113,#18181b);border:1px solid rgba(255,255,255,0.08);box-shadow:0 30px 60px rgba(0,0,0,0.8),inset 0 1px 0 rgba(255,255,255,0.1);color:#F5F5F7;border-radius:20px;overflow:hidden;max-width:680px;">

        <!-- Modal header -->
        <div style="background:linear-gradient(90deg,rgba(0,113,227,0.12),transparent);border-bottom:1px solid rgba(255,255,255,0.07);padding:20px 24px;display:flex;align-items:center;justify-content:space-between;">
          <div style="display:flex;align-items:center;gap:12px;">
            <div style="width:40px;height:40px;border-radius:10px;background:rgba(0,113,227,0.18);border:1px solid rgba(0,113,227,0.3);display:flex;align-items:center;justify-content:center;color:#5AC8FA;font-size:17px;">
              <i class="fas fa-id-card-clip"></i>
            </div>
            <div>
              <h3 style="color:#fff;font-weight:700;font-size:17px;letter-spacing:-0.02em;margin:0;">Resume Intelligence</h3>
              <p style="color:rgba(255,255,255,0.4);font-size:12px;margin:3px 0 0;">AI-distilled professional profile</p>
            </div>
          </div>
          <button class="modal-close btn-icon" style="border-radius:50%;background:rgba(255,255,255,0.06);color:#fff;transition:all 0.25s;">
            <i class="fas fa-times"></i>
          </button>
        </div>

        <!-- Body -->
        <div class="modal-body-scroll" style="max-height:60vh;overflow-y:auto;padding:20px 24px;">
          <% if (space.purifiedSummary && space.purifiedSummary.length > 0) { %>
            <%- space.purifiedSummary %>
          <% } else { %>
            <div style="text-align:center;padding:40px 0;">
              <i class="fas fa-file-slash" style="font-size:36px;color:rgba(255,255,255,0.12);margin-bottom:16px;display:block;"></i>
              <p style="color:rgba(255,255,255,0.35);">No resume summary available.</p>
              <p style="color:rgba(255,255,255,0.2);font-size:12px;margin-top:6px;">The summary may still be generating or there was an AI error.</p>
            </div>
          <% } %>
        </div>

        <!-- Footer -->
        <div style="padding:14px 24px;border-top:1px solid rgba(255,255,255,0.06);background:rgba(0,0,0,0.2);display:flex;justify-content:flex-end;gap:10px;">
          <% if (space.resumePath) { %>
            <a href="/space/resume/download/<%= space._id %>" class="btn btn-sm" style="background:rgba(255,255,255,0.08);color:#fff;border:1px solid rgba(255,255,255,0.15);">
              <i class="fas fa-download" style="font-size:11px;"></i> Download Resume
            </a>
          <% } %>
          <button class="modal-close btn btn-sm" style="background:rgba(255,255,255,0.06);color:rgba(255,255,255,0.6);border:1px solid rgba(255,255,255,0.1);">Close</button>
        </div>
      </div>
    </div>

    <!-- ═══════════════════════════════════════
                                 Interview Summary Modal
                                 ═══════════════════════════════════════ -->
    <div id="interviewSummaryModal" class="modal-backdrop">
      <div class="modal-window modal-window-lg">
        <!-- Header -->
        <div class="flex items-center justify-between px-6 pt-6 pb-4">
          <div class="flex items-center gap-4">
            <div style="background: rgba(0, 113, 227, 0.15); color: #0071E3; width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 18px; border: 1px solid rgba(0, 113, 227, 0.3);">
              <i class="fas fa-brain"></i>
            </div>
            <div>
              <h3 class="mb-0" style="color: #fff;">AI Evaluation Report</h3>
              <p style="color: rgba(255,255,255,0.5); font-size: 13px; margin-top: 2px;">Comprehensive multi-agent analysis</p>
            </div>
          </div>
          <button class="modal-close btn-icon" style="border-radius: 50%;">
            <i class="fas fa-times"></i>
          </button>
        </div>

        <!-- Modal Tabs -->
        <div class="tabs px-4 mb-4">
          <button class="tab active summary-tab" data-tab="summary">Overview</button>
          <button class="tab summary-tab" data-tab="questions">Questions &amp; Analysis</button>
          <button class="tab summary-tab" data-tab="feedback">Detailed Feedback</button>
        </div>

        <!-- Tab: Overview -->
        <div id="summaryTab" class="summary-section active px-6">
          <div id="summaryContent" class="modal-body-scroll">
            <!-- Markdown content dynamically placed here -->
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mt-8 mb-6">
            <div class="glass-card">
              <h4 class="flex items-center gap-2" style="font-size: 15px;">
                <i class="fas fa-shield-check" style="color: #34C759;"></i> Demonstrated Strengths
              </h4>
              <ul id="keyStrengths" class="text-sm flex flex-col gap-3"></ul>
            </div>
            <div class="glass-card">
              <h4 class="flex items-center gap-2" style="font-size: 15px;">
                <i class="fas fa-engine-warning" style="color: #FF9F0A;"></i> Target Areas to Improve
              </h4>
              <ul id="areasToImprove" class="text-sm flex flex-col gap-3"></ul>
            </div>
          </div>
        </div>

        <!-- Tab: Questions -->
        <div id="questionsTab" class="summary-section px-6 mb-6">
          <div class="modal-body-scroll" style="padding-right: 8px;">
            <div id="questionsContent" class="flex flex-col gap-5">
              <p class="text-center py-12" style="color: rgba(255,255,255,0.3);">Retrieving transcript timeline...</p>
            </div>
          </div>
        </div>

        <!-- Tab: Feedback -->
        <div id="feedbackTab" class="summary-section px-6 mb-6">
          <div class="modal-body-scroll">
            <div id="feedbackContent" class="flex flex-col gap-4">
              <p class="text-center py-12" style="color: rgba(255,255,255,0.3);">Parsing advanced heuristics...</p>
            </div>
          </div>
        </div>

        <!-- Footer -->
        <div class="flex justify-between items-center px-6 py-4" style="background: rgba(0,0,0,0.2); border-top: 1px solid rgba(255,255,255,0.06);">
          <button class="btn btn-sm" id="practiceAgainBtn" style="background: #0071E3; color: #fff; border: none; font-weight: 500; box-shadow: 0 4px 14px rgba(0, 113, 227, 0.4);">
            <i class="fas fa-redo-alt mr-2" style="font-size: 12px;"></i> Retake Round
          </button>
          <button class="modal-close btn btn-sm" style="background: rgba(255,255,255,0.1); color: #fff; border: 1px solid rgba(255,255,255,0.2);">Close Report</button>
        </div>
      </div>
    </div>

    <!-- ─── Scripts ─── -->
     <%
const completedSummaries = (space.interviewRounds || [])
  .filter(r => r.status === 'completed' && r.summary)
  .reduce((acc, r) => {
    acc[r._id] = r.summary;
    return acc;
  }, {});
%>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script>
      const roundSummaries = <%- JSON.stringify(completedSummaries) %>;
      document.addEventListener('DOMContentLoaded', function () {
        // ─── Tabs Logic ───
        const tabs = document.querySelectorAll('.tab');
        const tabContents = document.querySelectorAll('.tab-content');

        tabs.forEach(tab => {
          if (tab.classList.contains('summary-tab')) return;

          tab.addEventListener('click', () => {
            tabs.forEach(t => {
              if (!t.classList.contains('summary-tab')) t.classList.remove('active');
            });
            tabContents.forEach(c => c.classList.remove('active'));

            tab.classList.add('active');
            const targetId = tab.getAttribute('data-tab') + 'Tab';
            const targetContent = document.getElementById(targetId);
            if (targetContent) targetContent.classList.add('active');
          });
        });

        // ─── Resume Summary Modal ───
        const viewFullSummaryBtn = document.getElementById('viewFullSummaryBtn');
        const resumeSummaryModal = document.getElementById('resumeSummaryModal');

        if (viewFullSummaryBtn && resumeSummaryModal) {
          viewFullSummaryBtn.addEventListener('click', () => {
            resumeSummaryModal.classList.add('active');
            document.body.classList.add('no-scroll');
          });
        }

        // ─── Interview Summary Modal ───
        const viewSummaryBtns = document.querySelectorAll('.view-summary-btn');
        const interviewSummaryModal = document.getElementById('interviewSummaryModal');
        const summaryTabs = document.querySelectorAll('.summary-tab');
        const summarySections = document.querySelectorAll('.summary-section');

        const summaryContent = document.getElementById('summaryContent');
        const keyStrengths = document.getElementById('keyStrengths');
        const areasToImprove = document.getElementById('areasToImprove');
        const questionsContent = document.getElementById('questionsContent');
        const feedbackContent = document.getElementById('feedbackContent');
        const practiceAgainBtn = document.getElementById('practiceAgainBtn');

        let currentSpaceId = '<%= space._id %>';

        viewSummaryBtns.forEach(btn => {
          btn.addEventListener('click', async () => {
            const roundId = btn.getAttribute('data-round-id');
            const roundName = btn.getAttribute('data-round-name');

            if (practiceAgainBtn) {
              practiceAgainBtn.onclick = () => {
                window.location.href = `/space/${currentSpaceId}/round/${roundName}/start`;
              };
            }

            interviewSummaryModal.classList.add('active');
            document.body.classList.add('no-scroll');

            summaryTabs.forEach(t => t.classList.remove('active'));
            summarySections.forEach(s => s.classList.remove('active'));
            summaryTabs[0].classList.add('active');
            document.getElementById('summaryTab').classList.add('active');

            const rawSummary = roundSummaries[roundId];
            if (rawSummary) {
              summaryContent.innerHTML = marked.parse(rawSummary);
              extractAndPopulateList(rawSummary, "Key Strengths", keyStrengths, "fa-check-circle", "var(--success-color)");
              extractAndPopulateList(rawSummary, "Critical Areas for Improvement", areasToImprove, "fa-exclamation-circle", "var(--warning-color)");
            } else {
              summaryContent.innerHTML = '<p class="text-center text-muted">Summary not available.</p>';
              keyStrengths.innerHTML = '';
              areasToImprove.innerHTML = '';
            }

            loadQuestions(roundId);
          });
        });

        // Close Modals
        const closeButtons = document.querySelectorAll('.modal-close');
        closeButtons.forEach(btn => {
          btn.addEventListener('click', () => {
            document.querySelectorAll('.modal-backdrop').forEach(m => m.classList.remove('active'));
            document.body.classList.remove('no-scroll');
          });
        });

        // Modal Tabs Logic
        summaryTabs.forEach(tab => {
          tab.addEventListener('click', () => {
            summaryTabs.forEach(t => t.classList.remove('active'));
            summarySections.forEach(s => s.classList.remove('active'));

            tab.classList.add('active');
            const targetId = tab.getAttribute('data-tab') + 'Tab';
            document.getElementById(targetId).classList.add('active');
          });
        });

        function extractAndPopulateList(markdown, headerText, container, iconClass, iconColor) {
          container.innerHTML = '';
          const lines = markdown.split('\n');
          let capture = false;

          for (let line of lines) {
            if (line.includes(headerText)) {
              capture = true;
              continue;
            }
            if (capture && line.startsWith('##')) {
              capture = false;
              break;
            }
            if (capture && (line.trim().startsWith('-') || line.trim().startsWith('*'))) {
              const text = line.replace(/^[\-\*]\s+/, '').trim().replace(/\*\*/g, '');
              const li = document.createElement('li');
              li.className = 'flex items-start gap-2';
              li.innerHTML = `<i class="fas ${iconClass} mt-1" style="color: ${iconColor}; flex-shrink: 0;"></i> <span>${text}</span>`;
              container.appendChild(li);
            }
          }

          if (container.children.length === 0) {
            container.innerHTML = '<li class="text-muted italic">No specific points found.</li>';
          }
        }

        async function loadQuestions(roundId) {
          questionsContent.innerHTML = '<p class="text-center py-8">Loading...</p>';
          feedbackContent.innerHTML = '<p class="text-center py-8">Loading...</p>';

          try {
            const response = await fetch(`/api/questions-answers/${roundId}`);
            const data = await response.json();

            if (data && data.length > 0) {
              renderQuestions(data);
              renderFeedback(data);
            } else {
              questionsContent.innerHTML = '<p class="text-center py-8">No questions recorded.</p>';
              feedbackContent.innerHTML = '<p class="text-center py-8">No detailed feedback available.</p>';
            }
          } catch (e) {
            console.error("Error loading Q&A:", e);
            questionsContent.innerHTML = '<p class="text-center text-danger">Error loading data.</p>';
          }
        }

        function renderQuestions(data) {
          questionsContent.innerHTML = '';
          data.forEach((item, index) => {
            const div = document.createElement('div');
            div.className = 'qa-card';
            div.innerHTML = `
              <div class="qa-badge">Prompt ${index + 1}</div>
              <p class="qa-question">${item.question}</p>
              <div class="qa-answer-box">
                 <i class="fas fa-quote-left mr-2" style="opacity: 0.3;"></i>
                 ${item.answer || '<em>Candidate did not provide a recorded response to this prompt.</em>'}
              </div>
            `;
            questionsContent.appendChild(div);
          });
        }

        function renderFeedback(data) {
          feedbackContent.innerHTML = `
          <div class="text-center py-8">
             <i class="fas fa-info-circle text-2xl mb-3 text-primary"></i>
             <p>Detailed feedback is integrated into the <strong>Overview</strong> tab.</p>
             <p class="text-sm text-tertiary mt-2">Check the "Key Strengths" and "Areas to Improve" sections.</p>
          </div>
        `;
        }
      });
    </script>
</body>

</html>