<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profile | CommunicateAI Pro</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

  <!-- Navigation -->
  <nav class="navbar" id="navbar">
    <div class="container nav-container">
      <a href="/dashboard" class="nav-logo">
        <div class="nav-logo-icon"><i class="fas fa-robot"></i></div>
        CommunicateAI
      </a>
      <div class="flex items-center gap-4">
        <a href="/dashboard" class="nav-link"><i class="fas fa-arrow-left mr-1"></i> Dashboard</a>
        <a href="/end-session" class="nav-link" style="color: var(--danger-color);"><i class="fas fa-sign-out-alt mr-1"></i> End Session</a>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <main class="min-h-screen flex items-center justify-center" style="padding-top: 96px; padding-bottom: 48px;">
    <div style="max-width: 520px; width: 100%; padding: 0 24px;">

      <!-- Profile Header -->
      <div class="text-center mb-10 fade-in">
        <div style="width: 80px; height: 80px; border-radius: 50%; background: var(--bg-color); border: 2px solid var(--border-color); display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; font-size: 32px; color: var(--text-tertiary);">
          <i class="fas fa-user"></i>
        </div>
        <h2 class="mb-1">Your Profile</h2>
        <p class="text-sm" style="color: var(--text-secondary);">Manage your session details</p>
      </div>

      <!-- Success Alert -->
      <% if (success) { %>
        <div class="alert alert-success mb-6">
          <i class="fas fa-check-circle"></i>
          <span>Profile updated successfully!</span>
        </div>
      <% } %>

      <!-- Profile Card -->
      <div class="card-static p-8 mb-6 fade-in" style="animation-delay: 0.1s;">
        <div class="flex items-center gap-2 mb-6">
          <i class="fas fa-id-card" style="color: var(--accent-color);"></i>
          <h4>Session Details</h4>
        </div>

        <!-- Session ID (Read-only) -->
        <div class="mb-6">
          <label>Session ID</label>
          <div class="flex items-center gap-2">
            <div class="flex-1 p-3 font-mono text-sm" style="background: var(--bg-color); border: 1px solid var(--border-color); border-radius: var(--radius-sm); color: var(--text-primary);">
              <%= uniqueId %>
            </div>
            <button onclick="copyToClipboard('<%= uniqueId %>')" class="btn btn-secondary" style="padding: 10px 14px;" title="Copy ID">
              <i class="fas fa-copy"></i>
            </button>
          </div>
          <p class="text-xs mt-1" style="color: var(--text-tertiary);">Save this ID to continue your session later.</p>
        </div>

        <!-- Update Name Form -->
        <form action="/update-profile" method="POST">
          <div class="mb-6">
            <label for="name">Display Name</label>
            <input type="text" id="name" name="name" value="<%= name %>" required placeholder="Enter your name">
          </div>
          <button type="submit" class="btn btn-primary w-full" style="padding: 12px;">
            <i class="fas fa-save mr-1"></i> Update Profile
          </button>
        </form>
      </div>

      <!-- Quick Actions -->
      <div class="grid grid-cols-2 gap-4 fade-in" style="animation-delay: 0.2s;">
        <a href="/dashboard" class="card p-5 text-center">
          <i class="fas fa-columns text-xl mb-2" style="color: var(--accent-color);"></i>
          <p class="text-sm font-medium">Dashboard</p>
        </a>
        <a href="/end-session" class="card p-5 text-center" style="border-color: rgba(255, 59, 48, 0.15);">
          <i class="fas fa-sign-out-alt text-xl mb-2" style="color: var(--danger-color);"></i>
          <p class="text-sm font-medium">End Session</p>
        </a>
      </div>

    </div>
  </main>

  <script>
    function copyToClipboard(text) {
      navigator.clipboard.writeText(text).then(() => {
        const btn = event.currentTarget;
        const icon = btn.querySelector('i');
        icon.className = 'fas fa-check';
        icon.style.color = 'var(--success-color)';
        setTimeout(() => {
          icon.className = 'fas fa-copy';
          icon.style.color = '';
        }, 2000);
      });
    }

    // Navbar scroll
    window.addEventListener('scroll', () => {
      document.getElementById('navbar').classList.toggle('scrolled', window.scrollY > 20);
    });
  </script>
</body>
</html>
