<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard | CommunicateAI Pro</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css">

  <!-- JQuery & Select2 (Required for form) -->
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
</head>

<body>

  <div class="dashboard-layout">
    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="mb-8 px-2">
        <a href="/" class="flex items-center gap-2 font-bold text-primary">
          <div
            style="width: 24px; height: 24px; background: var(--text-primary); border-radius: 6px; display: flex; align-items: center; justify-content: center;">
            <i class="fas fa-robot text-white" style="font-size: 12px;"></i>
          </div>
          CommunicateAI
        </a>
      </div>

      <nav class="sidebar-nav">
        <a href="/dashboard" class="sidebar-link active">
          <i class="fas fa-columns" style="width: 20px;"></i>
          Dashboard
        </a>
        <a href="/performance" class="sidebar-link">
          <i class="fas fa-chart-bar" style="width: 20px;"></i>
          Performance
        </a>
        <a href="#" class="sidebar-link">
          <i class="fas fa-cog" style="width: 20px;"></i>
          Settings
        </a>
      </nav>

      <div class="mt-auto px-2">
        <div class="p-3 bg-gray-50 rounded-lg border border-gray-200">
          <p class="text-xs font-bold text-primary">
            <%= name %>
          </p>
          <p class="text-xs text-secondary truncate"
            title="Session: <%= uniqueId || (session && session.uniqueId) || 'N/A' %>">ID: <%= uniqueId ?
              uniqueId.substring(0,8) + '...' : 'N/A' %>
          </p>
        </div>
        <a href="/end-session" class="sidebar-link mt-2 text-danger">
          <i class="fas fa-sign-out-alt" style="width: 20px;"></i>
          Sign Out
        </a>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
      <!-- Top Header -->
      <header class="flex justify-between items-center mb-10">
        <div>
          <h2 class="mb-1">Dashboard</h2>
          <p class="text-sm">Manage your interview spaces and track progress.</p>
        </div>
        <button id="openCreateSpaceBtn" class="btn btn-primary btn-sm">
          <i class="fas fa-plus mr-2"></i> New Space
        </button>
      </header>

      <!-- Stats Row -->
      <%
        // Compute real-time stats from spaces data
        const totalSpaces = spaces ? spaces.length : 0;
        let _totalRounds = 0;
        let _completedRounds = 0;
        let _pendingRounds = 0;

        if (spaces) {
          spaces.forEach(space => {
            if (space.interviewRounds) {
              _totalRounds += space.interviewRounds.length;
              space.interviewRounds.forEach(r => {
                if (r.status === 'completed') _completedRounds++;
                else _pendingRounds++;
              });
            }
          });
        }

        const _completionRate = _totalRounds > 0 ? Math.round((_completedRounds / _totalRounds) * 100) : 0;
        const _pendingRate = _totalRounds > 0 ? Math.round((_pendingRounds / _totalRounds) * 100) : 0;
      %>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
        <div class="card p-6">
          <div class="flex justify-between items-start mb-4">
            <div>
              <p class="text-sm text-secondary font-medium uppercase">Active Spaces</p>
              <h3 class="text-3xl font-bold mt-1">
                <%= totalSpaces %>
              </h3>
            </div>
            <div class="p-2 bg-blue-50 rounded-lg text-accent">
              <i class="fas fa-briefcase"></i>
            </div>
          </div>
          <div class="flex justify-between text-xs text-tertiary mb-1">
            <span><%= _totalRounds %> total rounds</span>
            <span><%= _completionRate %>% complete</span>
          </div>
          <div class="progress-bar-container">
            <div class="progress-bar-fill" style="width: <%= _completionRate %>%;"></div>
          </div>
        </div>

        <div class="card p-6">
          <div class="flex justify-between items-start mb-4">
            <div>
              <p class="text-sm text-secondary font-medium uppercase">Completed Rounds</p>
              <h3 class="text-3xl font-bold mt-1">
                <%= _completedRounds %>
              </h3>
            </div>
            <div class="p-2 bg-green-50 rounded-lg text-success">
              <i class="fas fa-check-circle" style="color: var(--success-color);"></i>
            </div>
          </div>
          <div class="flex justify-between text-xs text-tertiary mb-1">
            <span><%= _completedRounds %> of <%= _totalRounds %></span>
            <span><%= _completionRate %>%</span>
          </div>
          <div class="progress-bar-container">
            <div class="progress-bar-fill" style="width: <%= _completionRate %>%; background: var(--success-color);"></div>
          </div>
        </div>

        <div class="card p-6">
          <div class="flex justify-between items-start mb-4">
            <div>
              <p class="text-sm text-secondary font-medium uppercase">Pending Rounds</p>
              <h3 class="text-3xl font-bold mt-1">
                <%= _pendingRounds %>
              </h3>
            </div>
            <div class="p-2 bg-orange-50 rounded-lg text-warning">
              <i class="fas fa-clock" style="color: var(--warning-color);"></i>
            </div>
          </div>
          <div class="flex justify-between text-xs text-tertiary mb-1">
            <span><%= _pendingRounds %> of <%= _totalRounds %></span>
            <span><%= _pendingRate %>%</span>
          </div>
          <div class="progress-bar-container">
            <div class="progress-bar-fill" style="width: <%= _pendingRate %>%; background: var(--warning-color);"></div>
          </div>
        </div>
      </div>

      <!-- Interview Spaces Table -->
      <div class="mb-4 flex items-center justify-between">
        <h3>Interview Spaces</h3>
        <!-- <div class="flex gap-2">
          <input type="text" placeholder="Search spaces..." class="px-3 py-2 border rounded-lg text-sm" style="width: 240px;">
        </div> -->
      </div>

      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th width="30%">Role & Company</th>
              <th width="15%">Experience</th>
              <th width="30%">Progress</th>
              <th width="15%">Status</th>
              <th width="10%">Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (spaces && spaces.length> 0) { %>
              <% spaces.forEach((space)=> { %>
                <tr>
                  <td>
                    <div class="active">
                      <div class="font-medium text-primary">
                        <%= space.jobPosition %>
                      </div>
                      <div class="text-sm text-secondary">
                        <%= space.companyName %>
                      </div>
                    </div>
                  </td>
                  <td>
                    <span class="badge badge-neutral capitalize">
                      <%= space.experienceLevel || 'Intermediate' %>
                    </span>
                  </td>
                  <td>
                    <div class="flex flex-col gap-1">
                      <div class="flex justify-between text-xs text-secondary">
                        <span>
                          <%= space.interviewRounds.filter(r=> r.status === 'completed').length %>/<%=
                              space.interviewRounds.length %> rounds
                        </span>
                        <span>
                          <%= Math.round((space.interviewRounds.filter(r=> r.status === 'completed').length /
                            space.interviewRounds.length) * 100) %>%
                        </span>
                      </div>
                      <div class="progress-bar-container" style="height: 4px;">
                        <div class="progress-bar-fill"
                          style="width: <%= (space.interviewRounds.filter(r => r.status === 'completed').length / space.interviewRounds.length) * 100 %>%;">
                        </div>
                      </div>
                    </div>
                  </td>
                  <td>
                    <% const isComplete=space.interviewRounds.every(r=> r.status === 'completed');
                      const isInProgress = space.interviewRounds.some(r => r.status !== 'pending');
                      %>
                      <% if (isComplete) { %>
                        <span class="badge badge-success">Completed</span>
                        <% } else if (isInProgress) { %>
                          <span class="badge badge-warning">In Progress</span>
                          <% } else { %>
                            <span class="badge badge-neutral">Pending</span>
                            <% } %>
                  </td>
                  <td>
                    <a href="/space/<%= space._id %>" class="btn btn-sm btn-secondary">View</a>
                  </td>
                </tr>
                <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="5" class="text-center p-8">
                        <div class="flex flex-col items-center justify-center">
                          <div class="mb-4 p-4 bg-gray-50 rounded-full">
                            <i class="fas fa-folder-open text-secondary text-2xl"></i>
                          </div>
                          <p class="text-secondary mb-4">No interview spaces found.</p>
                          <button class="btn btn-primary btn-sm" onclick="$('#openCreateSpaceBtn').click()">Create
                            One</button>
                        </div>
                      </td>
                    </tr>
                    <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <!-- Create Space Modal -->
  <div id="createSpaceModal" class="modal-backdrop">
    <div class="modal-window">
      <div class="flex items-center justify-between mb-6">
        <h3 class="mb-0">New Interview Space</h3>
        <button id="closeModalBtn" class="text-secondary hover:text-primary">
          <i class="fas fa-times"></i>
        </button>
      </div>

      <form id="createSpaceForm" action="/spaces/create" method="POST" enctype="multipart/form-data">
        <div class="grid grid-cols-2 gap-4 mb-4">
          <div>
            <label for="companyName">Company Name</label>
            <input type="text" id="companyName" name="companyName" placeholder="e.g. Google" required>
          </div>
          <div>
            <label for="jobPosition">Job Position</label>
            <input type="text" id="jobPosition" name="jobPosition" placeholder="e.g. Frontend Engineer" required>
          </div>
        </div>

        <div class="mb-4">
          <label for="experienceLevel">Experience Level</label>
          <select id="experienceLevel" name="experienceLevel" required>
            <option value="fresher">Fresher (0-1 years)</option>
            <option value="intermediate">Intermediate (1-4 years)</option>
            <option value="experienced">Experienced (4+ years)</option>
          </select>
        </div>

        <div class="mb-4">
          <label for="jobDescription">Job Description</label>
          <textarea id="jobDescription" name="jobDescription" rows="4" placeholder="Paste the job description here..."
            required></textarea>
        </div>

        <div class="mb-4">
          <label for="interviewRounds">Interview Rounds</label>
          <select id="interviewRounds" name="interviewRounds" multiple="multiple" class="w-full" required>
            <option value="HR" selected>HR</option>
            <option value="Technical" selected>Technical</option>
            <option value="Final">Final</option>
          </select>
        </div>

        <div class="mb-6">
          <label for="resume">Upload Resume (PDF/DOCX)</label>
          <input type="file" id="resume" name="resume" accept=".pdf,.doc,.docx" required>
        </div>

        <!-- Loading indicator -->
        <div id="loading" class="text-center py-4 hidden">
          <div class="spinner border-t-2 border-accent border-solid rounded-full w-6 h-6 animate-spin mx-auto mb-2">
          </div>
          <p class="text-sm text-secondary">Creating your personalized space...</p>
        </div>

        <div class="flex justify-end gap-3 pt-4 border-t border-gray-100">
          <button type="button" id="cancelBtn" class="btn btn-secondary">Cancel</button>
          <button type="submit" class="btn btn-primary">Create Space</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    $(document).ready(function () {
      // Initialize Select2
      $('#interviewRounds').select2({
        placeholder: "Select interview rounds",
        width: '100%',
        dropdownParent: $('#createSpaceModal')
      });

      // Modal Logic
      const modal = $('#createSpaceModal');
      const openBtn = $('#openCreateSpaceBtn');
      const closeBtn = $('#closeModalBtn, #cancelBtn');

      openBtn.on('click', function () {
        modal.removeClass('hidden').addClass('active');
        $('body').css('overflow', 'hidden'); // Prevent background scroll
      });

      closeBtn.on('click', function () {
        modal.removeClass('active');
        setTimeout(() => modal.addClass('hidden'), 200);
        $('body').css('overflow', '');
      });

      // Close on backdrop click
      modal.on('click', function (e) {
        if (e.target === this) {
          closeBtn.click();
        }
      });

      // Form Loading
      $('#createSpaceForm').on('submit', function () {
        $('#loading').removeClass('hidden');
        $('button[type="submit"]').prop('disabled', true).addClass('opacity-50');
      });

      // Auto-hide notifications if any
      // ... (keep if needed)
    });
  </script>
</body>

</html>