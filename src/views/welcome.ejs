<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Welcome | CommunicateAI Pro</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css">

  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>

<body>

  <!-- Navigation -->
  <nav class="navbar" id="navbar">
    <div class="container nav-container">
      <a href="/" class="nav-logo">
        <div class="nav-logo-icon"><i class="fas fa-robot"></i></div>
        CommunicateAI
      </a>
      <a href="/" class="nav-link">Back to Home</a>
    </div>
  </nav>

  <!-- Main Content -->
  <main class="min-h-screen flex items-center justify-center" style="padding-top: 100px; padding-bottom: 48px;">
    <div style="max-width: 896px; width: 100%; padding: 0 24px;">

      <div class="text-center mb-12 fade-in">
        <h1 class="mb-4" style="font-size: 48px;">Get Started</h1>
        <p class="text-xl" style="max-width: 560px; margin: 0 auto; color: var(--text-secondary);">
          Begin your journey to interview mastery. Create a new session or continue where you left off.
        </p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger mb-8 fade-in" style="max-width: 520px; margin-left: auto; margin-right: auto;">
          <i class="fas fa-exclamation-circle"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

        <!-- New Session Card -->
        <div class="card p-8 fade-in" style="animation-delay: 0.1s;">
          <div class="feature-icon mb-6">
            <i class="fas fa-plus"></i>
          </div>
          <h3 class="mb-2" style="font-size: 24px;">New Session</h3>
          <p class="text-sm mb-8" style="color: var(--text-secondary);">Start a fresh interview practice session tailored to your needs.</p>

          <form id="newSessionForm">
            <div class="mb-4">
              <label for="name">Your Name</label>
              <input type="text" id="name" name="name" required placeholder="Enter your name">
            </div>
            <button type="submit" class="btn btn-primary w-full" style="padding: 12px;">
              Create Session <i class="fas fa-arrow-right ml-2"></i>
            </button>
          </form>
        </div>

        <!-- Continue Session Card -->
        <div class="card p-8 fade-in" style="animation-delay: 0.2s;">
          <div class="feature-icon mb-6" style="background: rgba(0,0,0,0.04); color: var(--text-secondary);">
            <i class="fas fa-history"></i>
          </div>
          <h3 class="mb-2" style="font-size: 24px;">Continue Session</h3>
          <p class="text-sm mb-8" style="color: var(--text-secondary);">Resume your previous progress using your session ID.</p>

          <form id="continueSessionForm">
            <div class="mb-4">
              <label for="uniqueId">Session ID</label>
              <input type="text" id="uniqueId" name="uniqueId" required placeholder="e.g. ABC12345">
            </div>
            <button type="submit" class="btn btn-secondary w-full" style="padding: 12px;">
              Resume Session
            </button>
          </form>
        </div>

      </div>

      <div class="mt-10 text-center fade-in" style="animation-delay: 0.3s;">
        <div class="alert alert-warning" style="display: inline-flex;">
          <i class="fas fa-info-circle"></i>
          <span>Session IDs are unique. Keep yours safe to access your history.</span>
        </div>
      </div>

    </div>
  </main>

  <!-- Success Modal -->
  <div id="successModal" class="modal-backdrop">
    <div class="modal-window text-center" style="max-width: 400px;">
      <div style="width: 64px; height: 64px; border-radius: 50%; background: var(--success-subtle); display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; color: var(--success-color); font-size: 24px;">
        <i class="fas fa-check"></i>
      </div>
      <h3 class="mb-2" style="font-size: 24px;">Session Created!</h3>
      <p class="text-sm mb-6" style="color: var(--text-secondary);">Your session ID is generated below.</p>

      <div class="p-4 mb-6 flex items-center justify-between" style="background: var(--bg-color); border: 1px solid var(--border-color); border-radius: var(--radius-card);">
        <code id="sessionIdDisplay" class="font-mono font-bold text-lg" style="color: var(--text-primary); letter-spacing: 0.05em;">...</code>
        <button id="copyButton" class="btn-icon" style="background: transparent; color: var(--text-secondary);" title="Copy ID">
          <i class="fas fa-copy"></i>
        </button>
      </div>

      <button id="goToDashboardBtn" class="btn btn-primary w-full">
        Go to Dashboard
      </button>
    </div>
  </div>

  <script>
    $(document).ready(function () {

      // New Session
      $('#newSessionForm').on('submit', async function (e) {
        e.preventDefault();
        const name = $('#name').val().trim();
        if (!name) return;

        const btn = $(this).find('button[type="submit"]');
        const originalText = btn.html();
        btn.html('<i class="fas fa-spinner fa-spin"></i> Creating...').prop('disabled', true);

        try {
          const res = await fetch('/api/start-new', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name })
          });

          const data = await res.json();

          if (data.success) {
            $('#sessionIdDisplay').text(data.uniqueId);
            $('#goToDashboardBtn').data('url', data.redirectUrl);
            $('#successModal').addClass('active');
          } else {
            alert(data.error || 'Error creating session');
          }
        } catch (err) {
          console.error(err);
          alert('Network error');
        } finally {
          btn.html(originalText).prop('disabled', false);
        }
      });

      // Continue Session
      $('#continueSessionForm').on('submit', async function (e) {
        e.preventDefault();
        const uniqueId = $('#uniqueId').val().trim();
        if (!uniqueId) return;

        const btn = $(this).find('button[type="submit"]');
        const originalText = btn.html();
        btn.html('<i class="fas fa-spinner fa-spin"></i> Verifying...').prop('disabled', true);

        try {
          const res = await fetch('/api/continue-session', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ uniqueId })
          });

          const data = await res.json();
          if (data.success) {
            window.location.href = data.redirectUrl;
          } else {
            alert(data.error || 'Session not found');
          }
        } catch (err) {
          console.error(err);
          alert('Network error');
        } finally {
          btn.html(originalText).prop('disabled', false);
        }
      });

      // Modal Actions
      $('#copyButton').click(function () {
        const text = $('#sessionIdDisplay').text();
        navigator.clipboard.writeText(text);
        $(this).html('<i class="fas fa-check" style="color: var(--success-color);"></i>');
        setTimeout(() => $(this).html('<i class="fas fa-copy"></i>'), 2000);
      });

      $('#goToDashboardBtn').click(function () {
        window.location.href = $(this).data('url') || '/dashboard';
      });

    });
  </script>
</body>

</html>
